<div class="at-app">
  <header class="at-topbar">
    <nav class="at-tabs">
      <button type="button" class="at-tab {{#if tabs.roster}}active{{/if}}" data-action="switchTab" data-tab="roster">
        <i class="fa-solid fa-users"></i> {{localize "ARMY.Tabs.roster"}}
      </button>
      <button type="button" class="at-tab {{#if tabs.structure}}active{{/if}}" data-action="switchTab" data-tab="structure">
        <i class="fa-solid fa-sitemap"></i> {{localize "ARMY.Tabs.structure"}}
      </button>
      {{#if treasuryOn}}{{#if showFinances}}
      <button type="button" class="at-tab {{#if tabs.treasury}}active{{/if}}" data-action="switchTab" data-tab="treasury">
        <i class="fa-solid fa-scale-balanced"></i> {{localize "ARMY.Tabs.treasury"}}
      </button>
      {{/if}}{{/if}}
      <button type="button" class="at-tab {{#if tabs.ledger}}active{{/if}}" data-action="switchTab" data-tab="ledger">
        <i class="fa-solid fa-book-open"></i> {{localize "ARMY.Tabs.ledger"}}
      </button>
    </nav>
    <div class="at-day" data-tooltip="{{localize "ARMY.DayTooltip"}}">
      <i class="fa-solid fa-calendar-day"></i> {{localize "ARMY.Day"}} {{day}}
    </div>
    {{#if isGM}}
    <button type="button" class="at-advance" data-action="advanceDay">
      <i class="fa-solid fa-forward-step"></i> {{localize "ARMY.AdvanceDay"}}
    </button>
    <button type="button" class="at-advance at-advance-multi" data-action="advanceDays"
            data-tooltip="{{localize "ARMY.AdvanceDays"}}">
      <i class="fa-solid fa-forward-fast"></i>
    </button>
    <button type="button" class="at-bonus" data-action="grantBonus"
            data-tooltip="{{localize "ARMY.Bonus.tooltip"}}">
      <i class="fa-solid fa-gift"></i> {{localize "ARMY.Bonus.button"}}
    </button>
    {{#if undoLabel}}
    <button type="button" class="at-undo" data-action="undoLast"
            data-tooltip="{{localize "ARMY.Undo.tooltip" label=undoLabel}}">
      <i class="fa-solid fa-clock-rotate-left"></i>
    </button>
    {{/if}}
    {{/if}}
  </header>

  <section class="at-body">
    {{#if tabs.roster}}
    <div class="at-roster">
      {{#if roster.length}}
      <table class="at-table">
        <thead>
          <tr>
            <th class="at-col-expand"></th>
            <th class="at-col-name">{{localize "ARMY.Col.name"}}</th>
            <th class="at-col-rank">{{localize "ARMY.Col.rank"}}</th>
            <th class="at-col-num">{{localize "ARMY.Col.wage"}} <span class="at-unit-hint">({{currency}}/{{localize "ARMY.DayShort"}})</span></th>
            <th class="at-col-num">{{localize "ARMY.Col.net"}}</th>
            <th class="at-col-num">{{localize "ARMY.Col.debt"}}</th>
            <th class="at-col-num">{{localize "ARMY.Col.vault"}}</th>
            {{#if isGM}}<th class="at-col-actions"></th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each roster}}
          <tr class="at-row {{#if expanded}}expanded{{/if}}"
              data-member-id="{{id}}" data-can-requisition="{{canRequisition}}">
            <td class="at-col-expand">
              <button type="button" class="at-icon-btn" data-action="toggleRow" data-id="{{id}}"
                      data-tooltip="{{localize "ARMY.ToggleDetails"}}">
                <i class="fa-solid fa-chevron-{{#if expanded}}down{{else}}right{{/if}}"></i>
              </button>
            </td>
            <td class="at-name">
              {{#if img}}<img class="at-portrait" src="{{img}}" alt="">{{/if}}
              <span>{{name}}</span>
            </td>
            <td>
              <select data-path="{{path}}.rank" data-dtype="String" {{#unless @root.isGM}}disabled{{/unless}}>
                {{selectOptions @root.rankOptions selected=rank}}
              </select>
            </td>
            <td class="at-num">
              <input type="number" step="any" min="0" value="{{wageOverride}}" placeholder="{{defaultWage}}"
                     data-path="{{path}}.wageOverride" data-dtype="Number" data-nullable
                     data-tooltip="{{localize "ARMY.WageOverrideTooltip"}}"
                     {{#unless @root.isGM}}disabled{{/unless}}>
            </td>
            <td class="at-num at-net {{netClass}}">{{pay.netF}}</td>
            <td class="at-num">
              <input type="number" step="any" min="0" value="{{debt}}"
                     data-path="{{path}}.debt" data-dtype="Number"
                     {{#unless @root.isGM}}disabled{{/unless}}>
            </td>
            <td class="at-num">
              <input type="number" step="any" min="0" value="{{vault}}"
                     data-path="{{path}}.vault" data-dtype="Number"
                     {{#unless @root.isGM}}disabled{{/unless}}>
            </td>
            {{#if @root.isGM}}
            <td class="at-col-actions">
              <button type="button" class="at-icon-btn danger" data-action="removeMember"
                      data-index="{{index}}" data-name="{{name}}"
                      data-tooltip="{{localize "ARMY.RemoveMember"}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </td>
            {{/if}}
          </tr>
          {{#if expanded}}
          <tr class="at-detail-row">
            <td colspan="{{@root.colspan}}">
              <div class="at-detail">
                <div class="at-panel">
                  <h4><i class="fa-solid fa-utensils"></i> {{localize "ARMY.Deductions"}}</h4>
                  {{#if deductions.length}}
                  <ul class="at-deductions">
                    {{#each deductions}}
                    <li>
                      <input type="text" value="{{label}}" placeholder="{{localize "ARMY.DeductionPh"}}"
                             data-path="{{path}}.label" {{#unless @root.isGM}}disabled{{/unless}}>
                      <input class="at-amount" type="number" step="any" min="0" value="{{amount}}"
                             data-path="{{path}}.amount" data-dtype="Number"
                             {{#unless @root.isGM}}disabled{{/unless}}>
                      {{#if @root.isGM}}
                      <button type="button" class="at-icon-btn danger" data-action="removeDeduction"
                              data-array-path="{{arrayPath}}" data-index="{{index}}"
                              data-tooltip="{{localize "ARMY.RemoveDeduction"}}">
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                      {{/if}}
                    </li>
                    {{/each}}
                  </ul>
                  {{else}}
                  <p class="at-empty">{{localize "ARMY.NoDeductions"}}</p>
                  {{/if}}
                  {{#if @root.isGM}}
                  <button type="button" class="at-add-small" data-action="addDeduction" data-array-path="{{path}}.deductions">
                    <i class="fa-solid fa-plus"></i> {{localize "ARMY.AddDeduction"}}
                  </button>
                  {{/if}}
                  <div class="at-line at-total">
                    <span>{{localize "ARMY.TotalDeductions"}}</span>
                    <span>&minus;{{pay.dedF}} {{@root.currency}}</span>
                  </div>
                </div>

                <div class="at-panel">
                  <h4><i class="fa-solid fa-coins"></i> {{localize "ARMY.Salary"}}</h4>
                  <div class="at-line"><span>{{localize "ARMY.BaseDaily"}}</span><span>{{pay.baseF}} {{@root.currency}}</span></div>
                  <div class="at-line"><span>{{localize "ARMY.DeductionsDaily"}}</span><span>&minus;{{pay.dedF}} {{@root.currency}}</span></div>
                  <div class="at-line at-total"><span>{{localize "ARMY.NetDaily"}}</span><span class="{{netClass}}">{{pay.netF}} {{@root.currency}}</span></div>
                  <div class="at-line"><span>{{localize "ARMY.Weekly" days=@root.daysPerWeek}}</span><span>{{pay.weeklyF}} {{@root.currency}}</span></div>
                  <div class="at-line"><span>{{localize "ARMY.Monthly" days=@root.daysPerMonth}}</span><span>{{pay.monthlyF}} {{@root.currency}}</span></div>
                  <div class="at-line"><span>{{localize "ARMY.Yearly" days=@root.daysPerYear}}</span><span>{{pay.yearlyF}} {{@root.currency}}</span></div>
                </div>

                <div class="at-panel">
                  <h4><i class="fa-solid fa-scale-balanced"></i> {{localize "ARMY.Finances"}}</h4>
                  <div class="at-line"><span>{{localize "ARMY.Col.debt"}}</span><span class="{{#if debt}}at-neg{{/if}}">{{debtF}} {{@root.currency}}</span></div>
                  <div class="at-line"><span>{{localize "ARMY.MaxLoan" months=@root.loanMonths}}</span><span>{{pay.maxLoanF}} {{@root.currency}}</span></div>
                  <div class="at-line at-unit-assign">
                    <span>{{localize "ARMY.Unit.posting"}}</span>
                    <select data-path="{{path}}.unitId" data-dtype="String" {{#unless @root.isGM}}disabled{{/unless}}
                            data-tooltip="{{localize "ARMY.Unit.postingTooltip"}}">
                      {{selectOptions @root.unitOptions selected=unitId}}
                    </select>
                  </div>
                  {{#if @root.treasuryOn}}{{#if @root.isGM}}
                  <div class="at-line">
                    <span>{{localize "ARMY.Treasury.accessLabel"}}</span>
                    <button type="button" class="at-icon-btn at-finance-toggle" data-action="cycleFinanceAccess"
                            data-index="{{index}}" data-state="{{financeAccess}}" data-tooltip="{{financeTip}}">
                      <i class="{{financeIcon}}"></i>
                    </button>
                  </div>
                  {{/if}}{{/if}}
                  {{#if @root.isGM}}
                  <div class="at-btn-row">
                    <button type="button" data-action="grantLoan" data-index="{{index}}" data-name="{{name}}">
                      <i class="fa-solid fa-hand-holding-dollar"></i> {{localize "ARMY.GrantLoan"}}
                    </button>
                    <button type="button" data-action="repayDebt" data-index="{{index}}"
                            data-tooltip="{{localize "ARMY.RepayDebtTooltip"}}">
                      <i class="fa-solid fa-rotate-left"></i> {{localize "ARMY.RepayDebt"}}
                    </button>
                  </div>
                  {{/if}}
                </div>

                <div class="at-panel">
                  <h4><i class="fa-solid fa-vault"></i> {{localize "ARMY.Col.vault"}}</h4>
                  {{#if carriedF}}
                  <div class="at-line"
                       data-tooltip="{{carriedCoins}}"><span>{{localize "ARMY.Transfer.carriedLabel"}}</span><span>{{carriedF}} {{@root.currency}}</span></div>
                  {{/if}}
                  <div class="at-line at-total"><span>{{localize "ARMY.Transfer.storedLabel"}}</span><span>{{vaultF}} {{@root.currency}}</span></div>
                  {{#if canRequisition}}
                  <div class="at-line at-requisition-hint">
                    <i class="fa-solid fa-clipboard-check"></i>
                    <span>{{localize "ARMY.Requisition.hint"}}</span>
                  </div>
                  {{/if}}
                  {{#if canTransact}}
                  <div class="at-btn-row">
                    <button type="button" data-action="depositVault" data-id="{{id}}"
                            data-tooltip="{{localize "ARMY.Transfer.depositTooltip"}}">
                      <i class="fa-solid fa-arrow-down-to-bracket"></i> {{localize "ARMY.Transfer.deposit"}}
                    </button>
                    <button type="button" data-action="withdrawVault" data-id="{{id}}"
                            data-tooltip="{{localize "ARMY.Transfer.withdrawTooltip"}}">
                      <i class="fa-solid fa-arrow-up-from-bracket"></i> {{localize "ARMY.Transfer.withdraw"}}
                    </button>
                  </div>
                  {{/if}}
                </div>
              </div>
            </td>
          </tr>
          {{/if}}
          {{/each}}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" class="at-totals-label">{{localize "ARMY.Totals"}}</td>
            <td class="at-num">{{totals.netF}}</td>
            <td class="at-num">{{totals.debtF}}</td>
            <td class="at-num">{{totals.vaultF}}</td>
            {{#if isGM}}<td></td>{{/if}}
          </tr>
        </tfoot>
      </table>
      {{else}}
      <p class="at-hint">{{localize "ARMY.RosterEmpty"}}</p>
      {{/if}}
      {{#if isGM}}
      <button type="button" class="at-add" data-action="addMember">
        <i class="fa-solid fa-user-plus"></i> {{localize "ARMY.AddMember"}}
      </button>
      {{/if}}
    </div>
    {{/if}}

    {{#if tabs.structure}}
    <div class="at-structure">
      <p class="at-hint">{{localize "ARMY.StructureHint"}}</p>
      <div class="at-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" class="at-search-input" value="{{searchQuery}}"
               placeholder="{{localize "ARMY.Search.placeholder"}}"
               data-tooltip="{{localize "ARMY.Search.tooltip"}}">
        {{#if searching}}
        <span class="at-search-count">{{matchSummary}}</span>
        <button type="button" class="at-icon-btn" data-action="clearSearch"
                data-tooltip="{{localize "ARMY.Search.clear"}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
        {{/if}}
      </div>
      <div class="at-structure-tools">
        <button type="button" data-action="expandAll" data-tooltip="{{localize "ARMY.ExpandAllTooltip"}}">
          <i class="fa-solid fa-angles-down"></i> {{localize "ARMY.ExpandAll"}}
        </button>
        <button type="button" data-action="collapseAll" data-tooltip="{{localize "ARMY.CollapseAllTooltip"}}">
          <i class="fa-solid fa-angles-up"></i> {{localize "ARMY.CollapseAll"}}
        </button>
        {{#if isGM}}
        <span class="at-tools-spacer"></span>
        <button type="button" data-action="generateArmy">
          <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "ARMY.Generate.button"}}
        </button>
        <button type="button" data-action="openConfig">
          <i class="fa-solid fa-sliders"></i> {{localize "ARMY.Config.open"}}
        </button>
        {{/if}}
      </div>
      {{#if noMatches}}
      <p class="at-empty">{{localize "ARMY.Search.none"}}</p>
      {{else}}
        {{#with army}}
          {{> "modules/foundry-army-tracker/templates/unit.hbs"}}
        {{/with}}
      {{/if}}
    </div>
    {{/if}}

    {{#if tabs.treasury}}
    <div class="at-treasury">
      <div class="at-chest {{#if treasury.inArrears}}at-arrears{{/if}}">
        <div class="at-chest-label">{{localize "ARMY.Treasury.balance"}}</div>
        <div class="at-chest-figure">{{treasury.balanceF}} <span>{{currency}}</span></div>
        {{#if treasury.inArrears}}
        <p class="at-chest-note at-neg"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ARMY.Treasury.arrears"}}</p>
        {{else}}{{#if treasury.daysLeft}}
        <p class="at-chest-note">{{localize "ARMY.Treasury.runway" days=treasury.daysLeft}}</p>
        {{/if}}{{/if}}
      </div>

      <div class="at-detail">
        <div class="at-panel">
          <h4><i class="fa-solid fa-tents"></i> {{localize "ARMY.Treasury.upkeepHeader"}}</h4>
          <div class="at-line">
            <span>{{localize "ARMY.Treasury.soldiers" count=treasury.soldiers rate=treasury.perSoldierF}}</span>
            <span>{{treasury.soldierCostF}} {{currency}}</span>
          </div>
          <div class="at-line">
            <span>{{localize "ARMY.Treasury.officers" count=treasury.officers rate=treasury.perOfficerF}}</span>
            <span>{{treasury.officerCostF}} {{currency}}</span>
          </div>
          <div class="at-line"><span>{{localize "ARMY.Treasury.payroll"}}</span><span>{{treasury.payrollF}} {{currency}}</span></div>
          <div class="at-line at-total"><span>{{localize "ARMY.Treasury.daily"}}</span><span>{{treasury.dailyF}} {{currency}}</span></div>
          <div class="at-line"><span>{{localize "ARMY.Monthly" days=daysPerMonth}}</span><span>{{treasury.monthlyF}} {{currency}}</span></div>
          <p class="at-hint">{{localize "ARMY.Treasury.upkeepHint"}}</p>
        </div>

        <div class="at-panel">
          <h4><i class="fa-solid fa-eye"></i> {{localize "ARMY.Treasury.visibilityHeader"}}</h4>
          <p class="at-hint">{{treasury.visibility}}</p>
          {{#if isGM}}
          <div class="at-btn-row">
            <button type="button" data-action="openConfig">
              <i class="fa-solid fa-sliders"></i> {{localize "ARMY.Config.open"}}
            </button>
          </div>
          {{/if}}
        </div>
      </div>

      {{#if isGM}}
      <div class="at-btn-row at-treasury-actions">
        <button type="button" data-action="recordLoot" data-tooltip="{{localize "ARMY.Loot.tooltip"}}">
          <i class="fa-solid fa-sack-dollar"></i> {{localize "ARMY.Loot.button"}}
        </button>
        <button type="button" data-action="shareOut" data-tooltip="{{localize "ARMY.Shares.tooltip"}}">
          <i class="fa-solid fa-hand-holding-heart"></i> {{localize "ARMY.Shares.button"}}
        </button>
        <button type="button" data-action="setTreasury" data-tooltip="{{localize "ARMY.Treasury.setTooltip"}}">
          <i class="fa-solid fa-pen"></i> {{localize "ARMY.Treasury.set"}}
        </button>
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{#if tabs.ledger}}
    <div class="at-ledger">
      <div class="at-ledger-filters">
        <select data-ledger-filter="type">{{selectOptions ledgerTypeOptions selected=ledgerType}}</select>
        <select data-ledger-filter="member">{{selectOptions ledgerMemberOptions selected=ledgerMember}}</select>
        {{#if ledgerFiltered}}
        <button type="button" class="at-icon-btn" data-action="clearLedgerFilter"
                data-tooltip="{{localize "ARMY.Ledger.clearFilter"}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
        {{/if}}
      </div>
      {{#if ledger.length}}
      <table class="at-table at-ledger-table">
        <thead>
          <tr>
            <th class="at-col-day">{{localize "ARMY.Day"}}</th>
            <th>{{localize "ARMY.Ledger.entry"}}</th>
            <th class="at-col-name">{{localize "ARMY.Ledger.subject"}}</th>
            <th class="at-col-num">{{localize "ARMY.Ledger.amount"}}</th>
            <th class="at-col-num">{{localize "ARMY.Ledger.balance"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each ledger}}
          <tr class="at-ledger-row at-scope-{{scope}}">
            <td class="at-col-day">{{day}}</td>
            <td class="at-ledger-entry">
              <i class="fa-solid {{icon}}"></i> {{typeLabel}}
              {{#if note}}<span class="at-ledger-note">{{note}}</span>{{/if}}
            </td>
            <td class="at-c-name">{{subject}}</td>
            <td class="at-num {{amountClass}}">{{amountF}}</td>
            <td class="at-num">{{#if balanceF}}{{balanceF}}<span class="at-ledger-target">{{targetLabel}}</span>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="at-empty">{{localize "ARMY.Ledger.empty"}}</p>
      {{/if}}
    </div>
    {{/if}}
  </section>
</div>
